{
    "compilerOptions": {
        "target": "ES2022",
        "module": "Node16",
        "moduleResolution": "Node16",
        "rootDir": ".",
        "outDir": "dist",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "declaration": false,
        "sourceMap": true,
        "types": [
            "node"
        ]
    },
    "include": [
        "src/**/*.ts",
        "prisma/**/*.ts",
        "framework/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}