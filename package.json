{
    "name": "users-api",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "Clean layered backend — auth, users, profiles",
    "main": "dist/src/index.js",
    "scripts": {
        "dev": "nodemon --exec tsx src/index.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/src/index.js",
        "lint": "eslint \"src/**/*.ts\"",
        "lint:fix": "eslint \"src/**/*.ts\" --fix",
        "format": "prettier --write \"src/**/*.ts\" \"prisma/**/*.ts\"",
        "db:migrate": "prisma migrate dev",
        "db:generate": "prisma generate",
        "db:push": "prisma db push",
        "db:seed": "tsx prisma/seed.ts"
    },
    "prisma": {
        "seed": "tsx prisma/seed.ts"
    },
    "dependencies": {
        "@prisma/client": "^6.12.0",
        "argon2": "^0.44.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3",
        "rate-limiter-flexible": "^11.2.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^26.6.2",
        "eslint": "^9.0.0",
        "nodemon": "^3.1.14",
        "prettier": "^3.6.2",
        "prisma": "^6.12.0",
        "tsx": "^4.22.4",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.0.0"
    }
}
